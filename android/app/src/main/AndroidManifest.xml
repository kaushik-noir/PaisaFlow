<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- API calls to the PaisaFlow backend -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Voice input (speech-to-text plugs in next phase) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Fingerprint / device-credential unlock (RULES.md §18 shared-phone mitigation) -->
    
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"  implementation(libs.androidx.core.ktx)
    implementation(libs.androidx.lifecycle.runtime.ktx)
    implementation(libs.androidx.lifecycle.viewmodel.compose)
    implementation(libs.androidx.lifecycle.runtime.compose)
    implementation(libs.androidx.activity.compose)
    implementation(platform(libs.androidx.compose.bom))
        android:supportsRtl="true"
        android:theme="@style/Theme.PaisaFlow"
        android:usesCleartextTraffic="true">
        <!-- usesCleartextTraffic is for the local dev backend only; use HTTPS in production (RULES.md §15) -->

        
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
